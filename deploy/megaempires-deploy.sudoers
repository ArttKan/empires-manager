# The application account megaempires has no sudo rights. The deploy script does
# need one thing, however: restarting this one service. The rule is scoped to
# exactly that command, not to systemctl in general.
#
# Installation (visudo checks the syntax before saving):
#   sudo install -m 0440 -o root -g root \
#       deploy/megaempires-deploy.sudoers /etc/sudoers.d/megaempires-deploy
#   sudo visudo -c
#
# Sudo compares the command as a string, so deploy.sh calls the same absolute
# path /usr/bin/systemctl. Check with: command -v systemctl

megaempires ALL=(root) NOPASSWD: /usr/bin/systemctl restart mega-empires-backend.service
