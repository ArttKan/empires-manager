; This file is the only version of the unit: it holds no secrets, so it is an
; ordinary git-tracked file and reaches the server normally.
; The secrets are read from an EnvironmentFile outside the repo.
;
; Installation:
;   sudo cp deploy/mega-empires-backend.service /etc/systemd/system/
;   sudo systemctl daemon-reload
;   sudo systemctl restart mega-empires-backend.service
;
; NOTE: EnvironmentFile is mandatory. If the file is missing the service does not
; start at all — deliberately, so that a missing token shows immediately rather
; than as wrong behaviour at runtime.

[Unit]
Description=Mega Empires backend
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=megaempires
Group=megaempires
WorkingDirectory=/home/megaempires/mega-empires-backend

; StateDirectory creates /var/lib/mega-empires, gives it to the service user and
; keeps it writable despite ProtectSystem=strict. The saves therefore live
; outside the source directory, where a git update cannot destroy them.
StateDirectory=mega-empires
StateDirectoryMode=0750
Environment=MEGA_EMPIRES_DATA_DIR=/var/lib/mega-empires

; The secrets come from outside the repo. The file is root:root 0600, but systemd
; reads it before dropping to the service user, so the application account never
; needs access to it at all.
;
; Contents (one line):
;   ECHO_TOKEN=<oikea token>
;
; The variable name must match what main.py reads (ECHO_TOKEN, or the newer
; MEGA_EMPIRES_TOKEN). A wrong name does not stop startup; it shows up as HTTP
; 500 on the first request that needs the token.
EnvironmentFile=/etc/mega-empires-backend.env

; The application is main.py, and it serves web/index.html by a relative path, so
; WorkingDirectory is load-bearing rather than cosmetic.
; --timeout-graceful-shutdown is mandatory: /events is an infinite response, and
; without it uvicorn waits on open SSE streams and never exits. A single open
; phone hangs `systemctl restart` until TimeoutStopSec runs out.
ExecStart=/home/megaempires/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 \
    --timeout-graceful-shutdown 5
Restart=always
RestartSec=2
; A backstop in case the process still does not exit: systemd kills it after
; 20 seconds rather than the default 90.
TimeoutStopSec=20

; Once the saves moved to /var/lib, the service no longer needs write access to
; its own directory: a running application cannot alter its own code. The deploy
; script writes there from outside the sandbox.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
