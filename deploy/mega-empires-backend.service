; Tämä tiedosto on unitin ainoa versio: siinä ei ole salaisuuksia, joten se on
; tavallinen gitin seuraama tiedosto ja päivittyy palvelimelle normaalisti.
; Salaisuudet luetaan EnvironmentFile-tiedostosta repon ulkopuolelta.
;
; Asennus:
;   sudo cp deploy/mega-empires-backend.service /etc/systemd/system/
;   sudo systemctl daemon-reload
;   sudo systemctl restart mega-empires-backend.service
;
; HUOM: EnvironmentFile on pakollinen. Jos tiedosto puuttuu, palvelu ei käynnisty
; lainkaan — tämä on tahallista, jotta puuttuva token näkyy heti eikä vasta
; virheellisenä ajonaikaisena käytöksenä.

[Unit]
Description=Mega Empires backend
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=megaempires
Group=megaempires
WorkingDirectory=/home/megaempires/mega-empires-backend

; StateDirectory luo /var/lib/mega-empires, antaa sen omistajuuden palvelun
; käyttäjälle ja avaa sen kirjoitettavaksi ProtectSystem=strict -asetuksesta
; huolimatta. Tallennukset ovat siten koodihakemiston ulkopuolella, joten
; git-päivitys ei voi hävittää niitä.
StateDirectory=mega-empires
StateDirectoryMode=0750
Environment=MEGA_EMPIRES_DATA_DIR=/var/lib/mega-empires

; Salaisuudet tulevat repon ulkopuolelta. Tiedosto on root:root 0600, mutta
; systemd lukee sen ennen käyttäjän vaihtoa, joten sovelluskäyttäjän ei tarvitse
; päästä siihen käsiksi lainkaan.
;
; Sisältö (yksi rivi):
;   ECHO_TOKEN=<oikea token>
;
; Muuttujan nimen on vastattava main.py:n lukemaa nimeä (ECHO_TOKEN). Väärä nimi
; ei estä käynnistystä, vaan näkyy vasta /echo-reitin HTTP 500 -vastauksena.
EnvironmentFile=/etc/mega-empires-backend.env

; Sovellus on main.py ja se palvelee myös sse-test.html-tiedoston suhteellisella
; polulla, joten WorkingDirectory on merkityksellinen eikä vain kosmeettinen.
ExecStart=/home/megaempires/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=2

; Kun tallennukset siirtyivät /var/lib-hakemistoon, palvelu ei enää tarvitse
; kirjoitusoikeutta omaan hakemistoonsa: ajossa oleva sovellus ei voi muuttaa
; omaa koodiaan. Deploy-skripti kirjoittaa sinne sandboxin ulkopuolelta.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
